# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# ---- Public site details (safe to expose; shown on the site only when set) ----
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_RESPONSE_TIME=
# Show dashed "placeholder" blocks for missing content. Defaults to true in dev, false in production.
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# ---- Inquiry delivery (server-only secrets — never prefix with NEXT_PUBLIC_) ----
# Option A: email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=            # comma-separated list of recipients
INQUIRY_FROM_EMAIL=          # e.g. "Bamboo Coders Website <website@your-domain.com>"

# Option B: forward to a CRM or automation tool (HubSpot workflow, Zapier, Make, n8n, Supabase Edge Function…)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=      # sent as the X-Webhook-Secret header
